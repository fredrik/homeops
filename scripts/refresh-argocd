#!/usr/bin/env bash
# Ask ArgoCD to re-read Git now instead of waiting for the 60s poll plus
# the repo-server's revision cache. "hard" also bypasses that cache.
# Usage: git push && scripts/refresh-argocd
set -euo pipefail
kubectl --context admin@grove -n argocd annotate application argocd \
  argocd.argoproj.io/refresh=hard --overwrite
